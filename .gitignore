/export/
/data/
*.monodijson
/export.zip
# Example sets are generated by ui/scripts/split-corpus.mjs; only their README is tracked.
/examples/*
!/examples/README.md

# Local editor / agent config
.claude/
ui/.claude/
.gemini/
.agent/
.antigravity/

# OS files
.DS_Store
Thumbs.db

# Scratch
ui/scripts/_*.mjs

# Third-party reference data collected by scripts/crawl-mmmo.mjs; see the README before committing it
/ui/src/data/mmmo/
