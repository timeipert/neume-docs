# Saving to GitHub: see ../auth-proxy/README.md. Copy to .env.local and fill in.
# The client ID of the GitHub App (public, not a secret)
VITE_GITHUB_CLIENT_ID=
# The address of the sign-in helper, e.g. https://neume-docs-auth.example.workers.dev
VITE_AUTH_PROXY_URL=
# Optional: the app's page, for the "Install the app" button, e.g. https://github.com/apps/neume-docs
VITE_GITHUB_APP_URL=
